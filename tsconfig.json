{
  "extends": "@portal/presets/tsconfig/react-app.json",
  "compilerOptions": {
    // The monorepo also contains @types/react@19; React Router's typings must see this app's React 18 types.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src"]
}
