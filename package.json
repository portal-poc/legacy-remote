{
  "name": "legacy-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint .",
    "test": "echo \"no tests in legacy-remote\"",
    "verify": "portal-cli verify --mode bridge",
    "release:uat": "pnpm build && pnpm verify && portal-cli publish --nexus-dir ../../.infra/nexus && portal-cli release --stand uat --registry ../../registry --mode bridge && portal-cli registry build --stand uat --registry ../../registry --out ../../.infra/stands/uat/config.json"
  },
  "dependencies": {
    "@module-federation/bridge-react": "^2.9.2",
    "@portal/platform-contract": "workspace:^",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.5",
    "@portal/presets": "workspace:^",
    "@portal/vite-config": "workspace:^",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "portal-cli": "workspace:^",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
